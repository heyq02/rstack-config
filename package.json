{
  "name": "@heyq02/rstack-config",
  "version": "0.0.6",
  "description": "Opinionated Rstack CLI presets (lint, lib, app, fmt, test, staged, commitlint, tsconfig) with tree-shakeable subpath exports and define.extends support.",
  "keywords": [
    "commitlint",
    "conventional-commits",
    "flat-config",
    "fmt",
    "preset",
    "rsbuild",
    "rsdoctor",
    "rslib",
    "rslib-config",
    "rslint",
    "rslint-config",
    "rstack",
    "rstack-cli",
    "rstack-config",
    "staged",
    "tree-shaking",
    "tsconfig",
    "typescript"
  ],
  "homepage": "https://github.com/heyq02/rstack-config#readme",
  "bugs": {
    "url": "https://github.com/heyq02/rstack-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyq02/rstack-config.git"
  },
  "license": "MIT",
  "author": "Ari <mail@heyq02.cn>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./rslint": {
      "types": "./dist/rslint/index.d.ts",
      "default": "./dist/rslint/index.js"
    },
    "./rslib": {
      "types": "./dist/rslib/index.d.ts",
      "default": "./dist/rslib/index.js"
    },
    "./fmt": {
      "types": "./dist/fmt/index.d.ts",
      "default": "./dist/fmt/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    },
    "./staged": {
      "types": "./dist/staged/index.d.ts",
      "default": "./dist/staged/index.js"
    },
    "./commitlint": {
      "types": "./dist/commitlint/index.d.ts",
      "default": "./dist/commitlint/index.js"
    },
    "./tsconfig": "./tsconfigs/tsconfig.json",
    "./tsconfig.json": "./tsconfigs/tsconfig.json",
    "./tsconfig/app": "./tsconfigs/tsconfig.app.json",
    "./tsconfig.app.json": "./tsconfigs/tsconfig.app.json",
    "./rstack": {
      "types": "./dist/rstack/index.d.ts",
      "default": "./dist/rstack/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tsconfigs"
  ],
  "scripts": {
    "automd": "automd",
    "build": "rs lib",
    "build:rsdoctor": "RSDOCTOR=true rs lib",
    "check": "rs check && pnpm run typecheck",
    "check:package": "pnpm run build",
    "commitlint": "commitlint",
    "dev": "rs lib --watch",
    "format": "pnpm automd && rs fmt",
    "format:check": "rs fmt --check",
    "lint": "rs lint .",
    "lint:fix": "rs lint --fix .",
    "prepare": "rs hooks",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "test": "rs test",
    "test:coverage": "rs test --coverage",
    "typecheck": "tsc6 --noEmit"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "eslint-plugin-de-morgan": "^2.2.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "local-pkg": "^1.2.1",
    "rsbuild-plugin-arethetypeswrong": "^0.4.0",
    "rsbuild-plugin-publint": "^1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rslib/core": "^1.0.3",
    "@rslint/core": "^0.9.5",
    "@rstest/coverage-v8": "^0.12.3",
    "@types/node": "^26.1.1",
    "automd": "^0.4.3",
    "rstack": "^0.8.3",
    "typescript": "npm:@typescript/typescript6@^6.0.0"
  },
  "peerDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@rsdoctor/rspack-plugin": "^1.6.0",
    "@rslib/core": "^1.0.0",
    "@rslint/core": "^0.9.0",
    "rstack": "^0.8.0"
  },
  "peerDependenciesMeta": {
    "@commitlint/cli": {
      "optional": true
    },
    "@rsdoctor/rspack-plugin": {
      "optional": true
    },
    "@rslib/core": {
      "optional": true
    },
    "@rslint/core": {
      "optional": true
    },
    "rstack": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@heyq02/rstack-config",
  "version": "0.0.1",
  "description": "Opinionated Rstack presets: Rslint flat-config and Rslib library config, with tree-shakeable subpath exports.",
  "keywords": [
    "flat-config",
    "preset",
    "rsbuild",
    "rslib",
    "rslib-config",
    "rslint",
    "rslint-config",
    "rstack",
    "rstack-config",
    "tree-shaking",
    "typescript"
  ],
  "homepage": "https://github.com/heyq02/rstack-config#readme",
  "bugs": {
    "url": "https://github.com/heyq02/rstack-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyq02/rstack-config.git"
  },
  "license": "MIT",
  "author": "Ari <mail@heyq02.cn>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./rslint": {
      "types": "./dist/rslint/index.d.ts",
      "default": "./dist/rslint/index.js"
    },
    "./rslib": {
      "types": "./dist/rslib/index.d.ts",
      "default": "./dist/rslib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "automd": "automd",
    "build": "rs lib",
    "changelog": "changelogen",
    "changelog:sync": "changelogen gh release all",
    "check": "rs check && pnpm run typecheck",
    "check:package": "pnpm run build",
    "commitlint": "commitlint",
    "dev": "rs lib --watch",
    "format": "pnpm automd && rs fmt",
    "format:check": "rs fmt --check",
    "lint": "rs lint .",
    "lint:fix": "rs lint --fix .",
    "prepare": "rs hooks",
    "prepublishOnly": "pnpm run build",
    "release": "changelogen --release --no-github",
    "test": "rs test",
    "test:coverage": "rs test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "eslint-plugin-de-morgan": "^2.2.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "local-pkg": "^1.2.1",
    "rsbuild-plugin-publint": "^1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@rslib/core": "^1.0.3",
    "@rslint/core": "^0.9.5",
    "@rstest/coverage-v8": "^0.12.3",
    "@types/node": "^26.1.1",
    "automd": "^0.4.3",
    "changelogen": "^0.6.2",
    "rstack": "^0.8.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rslib/core": "^1.0.0",
    "@rslint/core": "^0.9.0"
  },
  "peerDependenciesMeta": {
    "@rslib/core": {
      "optional": true
    },
    "@rslint/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  }
}
